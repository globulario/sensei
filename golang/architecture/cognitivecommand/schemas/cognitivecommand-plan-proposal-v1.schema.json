{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/globulario/sensei/schema/cognitivecommand-plan-proposal-v1.json",
  "title": "Sensei Cognitive Command Plan Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "steps", "assumptions", "risks", "stop_conditions"],
  "properties": {
    "schema_version": { "const": "sensei.cognitivecommand.planproposal.v1" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "assumptions": { "$ref": "#/$defs/stringList" },
    "risks": { "$ref": "#/$defs/stringList" },
    "stop_conditions": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "description", "intended_files", "intended_symbols", "expected_evidence"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "intended_files": { "$ref": "#/$defs/stringList" },
        "intended_symbols": { "$ref": "#/$defs/stringList" },
        "expected_evidence": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
