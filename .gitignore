# Local runtime state (graph-authority marker written by `sensei rebuild`/`sensei serve`).
# .awg/ is the pre-rename name, still honored for existing repos.
/.sensei/
/.awg/

# Go build artifacts
/bin/
/sensei
/awg
# `go build ./cmd/<name>` writes its binary into the working directory, so every
# command in cmd/ needs an entry here or the next `git add -A` commits 27 MB of
# build output. Listed explicitly rather than by a wildcard: an ignore rule wide
# enough to swallow a stray binary is wide enough to swallow a source file
# somebody meant to commit.
/eval-arms
/import-scan
/loadnt
/yaml2nt
/awareness-graph
/awareness-mcp
/server
/principle-check
/yaml2nt
/loadnt
/proto-scan
*.test
*.out
*.exe
*.so
*.log

# Editor / IDE
.vscode/
.idea/
*.swp

# Local dev data
/.data/
/data/

# Generated proto output is COMMITTED, not ignored.
#
# We check in golang/pb/awareness_graph.pb.go and
# golang/pb/awareness_graph_grpc.pb.go so:
#   - Consumers don't need protoc + plugins installed to build or test.
#   - PRs that change the proto contract show the impact on generated
#     code, making API-level reviews concrete.
#   - `go test ./...` works on a fresh clone without `make proto` first.
# Use `make proto` to regenerate after editing proto/awareness_graph.proto.

# Throwaway spike output
/tmp/
/local/
/.cache/build-awareness-graph/*.meta
*.pyc
__pycache__/

# Combined cross-repository awareness seed: MUST NEVER be committed (it
# includes the paired services corpus and leaks internal detail the public
# self-only seed intentionally omits). Kept structurally separate from
# golang/server/embeddata/ (the self-only go:embed source) so neither build
# mode can overwrite the other's output at a shared path.
/.cache/awareness-combined/

# VS Code extension (editor/vscode) — Node build artifacts.
# package-lock.json IS committed (npm ci in CI needs it); the proto under
# editor/vscode/proto/ is committed (vendored, freshness-checked).
editor/vscode/node_modules/
editor/vscode/out/
editor/vscode/*.vsix

# SCIP index (binary; regenerated by `make scip`)
index.scip
*.scip

# stray go-build binaries (default output name = dir name)
/golang/server/server
bin/

# live-store backups and scratch caches — never publishable (a 53MB live-graph
# dump reached a PUBLIC repo this way, carrying private globular internals)
.cache/
