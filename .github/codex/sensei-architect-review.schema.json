{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "blind_spots", "required_proof"],
  "properties": {
    "verdict": {
      "enum": ["pass", "warn", "block", "cannot_verify"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "contract", "behavior", "evidence", "repair"],
        "properties": {
          "severity": {
            "enum": ["block", "warn", "advisory"]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "repair": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_proof": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
